# ============================================================
# Chronos Lab · environment
# Copy to `.env` (gitignored). Never commit secret keys.
# ============================================================

# --- Browser (Vite) ---
# Local Docker:  npm run supabase:start && npm run supabase:env
# Hosted:        Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=https://gkyhqnjgwxlyzptpiiob.supabase.co
# Prefer the new publishable key (sb_publishable_...). Legacy JWT anon key still works.
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Optional alias (client falls back to this if ANON_KEY is unset)
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional local flags
VITE_DEBUG=false
# Playwright only — enables mock session when localStorage chronos.e2e.auth=1
# VITE_E2E_AUTH=true

# Client error monitoring (production: GitHub Actions secret VITE_SENTRY_DSN)
# VITE_SENTRY_DSN=https://YOUR_KEY@o0.ingest.sentry.io/0

# --- Server / @supabase/server (Node, Workers, local tooling) ---
# On Supabase Edge Functions these are injected automatically — no setup needed.
# For other runtimes (and local scripts using createSupabaseContext), set:
SUPABASE_URL=https://gkyhqnjgwxlyzptpiiob.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key — Dashboard → API Keys → create/manage secret. NEVER VITE_ / never browser.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://gkyhqnjgwxlyzptpiiob.supabase.co/auth/v1/.well-known/jwks.json

# --- Supabase CLI (local only — never commit) ---
# Create at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...
# npx supabase link --project-ref gkyhqnjgwxlyzptpiiob

# --- Platform AI (capability port + router) ---
# Default provider: noop (deterministic scores/futures, no network).
# Recommendation enrich is ON by default when a non-noop provider is configured;
# set VITE_AI_SIM_ENRICH=false to keep deterministic prose only.
# VITE_AI_PROVIDER=noop
# VITE_AI_PROVIDER=ollama
# VITE_OLLAMA_URL=http://127.0.0.1:11434
# VITE_OLLAMA_MODEL=llama3.2
# VITE_AI_SIM_ENRICH=true
# VITE_AI_SIM_ENRICH=false

# --- Hosted Anthropic via the ai-generate Edge Function ---
# There is deliberately no VITE_ANTHROPIC_API_KEY. Every VITE_ value is
# inlined into the public bundle on GitHub Pages, so the key lives as a
# Supabase secret and only the Edge Function reads it. See SPEC-ai-proxy.md.
# VITE_AI_PROVIDER=anthropic
# Optional — derived from VITE_SUPABASE_URL when unset.
# VITE_AI_PROXY_URL=https://gkyhqnjgwxlyzptpiiob.supabase.co/functions/v1/ai-generate
#
# Set server-side, never in this file:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...     # required
#   supabase secrets set ANTHROPIC_MODEL=claude-opus-5    # optional override
#   supabase secrets set AI_RATE_PER_MINUTE=6             # per user
#   supabase secrets set AI_MONTHLY_CALL_CAP=200          # per user
#   supabase secrets set AI_GLOBAL_MONTHLY_CAP=5000       # 0 disables the function

